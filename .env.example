# ─── Base de données PostgreSQL (obligatoire maintenant) ───
DATABASE_URL="postgresql://vanguard:vanguard@localhost:5432/vanguard"

# ─── NextAuth / Discord OAuth ───
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genere-avec: openssl rand -base64 32"
DISCORD_CLIENT_ID="ton_client_id"
DISCORD_CLIENT_SECRET="ton_client_secret"     # ⚠️ régénère-le (l'ancien a été exposé)
DISCORD_GUILD_ID="id_de_ta_guilde_vanguard"

# ─── IDs des rôles Discord (clic droit rôle → Copier l'identifiant) ───
ROLE_DIRECTION=""
ROLE_VANGUARD=""
ROLE_GENERAL=""
ROLE_OFFICIER=""
ROLE_VETERAN=""
ROLE_GUARD=""

# ─── Webhook #candidatures ───
DISCORD_CANDIDATURES_WEBHOOK=""

# ─── BOT DISCORD ───
# Token du bot (Discord Developer Portal → ton app → Bot → Reset Token)
DISCORD_BOT_TOKEN=""
# Salons où le bot poste (clic droit salon → Copier l'identifiant)
CHANNEL_CANDIDATURES=""   # relances de candidatures (fallback si pas de salon staff)
CHANNEL_EVENTS=""         # rappels d'événements du jeu
CHANNEL_STAFF=""          # salon officiers (optionnel, prioritaire pour les relances ; défaut des essais)
# Chambres Secrètes et Guild Siege — FACULTATIFS : le paramétrage des bras droits
# (/discord/evenements, rubrique Salons) passe avant eux.
CHANNEL_CS=""             # salon des Chambres (panneau, rappels, récap, chrono) ; vide = 1498696982229811352
CHANNEL_CS_DEBRIEF=""     # salon (texte ou forum) des débriefs ; vide = CHANNEL_CS
CHANNEL_GS=""             # salon du Guild Siege (panneau, rappels, et ses débriefs par défaut) ; vide = CHANNEL_CS
# Le Guild Siege est ÉTEINT par défaut (le PvP n'est pas installé) : il s'allume dans le paramétrage.
# Les boutons « 🌐 Ouvrir sur le site » du bot prennent l'adresse de NEXTAUTH_URL ci-dessus
# (SITE_URL, facultatif, la remplace si le site est servi ailleurs).
# Les vidéos de débrief (fichiers MP4/WebM de 100 Mo au plus, joints par le staff) — FACULTATIF :
# vide = data/videos sous le dossier de lancement (/app/data/videos dans l'image, sur le volume
# vanguard_videos de docker-compose.prod.yml ; ./data/videos en local, ignoré par git).
VIDEOS_DIR=""

# ─── Mode dev local ───
# "1" (défaut) : simule un utilisateur connecté (rôle Direction) en base, sans Discord → localhost = prod.
# "0" : exige la vraie connexion Discord + vérification des rôles.
DEV_ALL_ACCESS="1"
NEXT_PUBLIC_DEV_ALL_ACCESS="1"
# Voir la barre d'un autre rôle (VISITEUR, AMI, RECRUE, GUARD, OFFICIER…), redémarrage requis.
# Ne change que la navigation ; les pages restent ouvertes par DEV_ALL. Sans effet en prod.
# DEV_ROLE="GUARD"

# Invitation au serveur Discord, affichee quand un visiteur connecte mais non
# membre tente d'ouvrir l'AirBuilder.
# A LAISSER VIDE dans le cas normal : le bot la genere lui-meme (il reutilise une
# invitation permanente existante, sinon il en cree une). Ne remplir que pour
# imposer une URL personnalisee (vanity), que l'API Discord ne renvoie pas.
NEXT_PUBLIC_DISCORD_INVITE=
